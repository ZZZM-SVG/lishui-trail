# 统一换行：仓库内存 LF，避免 Windows/macOS 之间产生整文件 diff
* text=auto eol=lf

# Windows 批处理用 CRLF 才稳妥（start.cmd 含标签跳转）
*.cmd text eol=crlf

# 由 data/checksums.json 逐字节校验的数据文件：禁止任何换行转换，
# 否则 clone 后 sha256 与 checksums.json 不一致（即使测试仍能跑，溯源声明会失真）
data/*.json -text
data/*.mjs -text
packages/lishui-trail-plugin/data/* -text

# 二进制
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gpx binary
*.xlsx binary
